{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RIGID ordered gene manifest",
  "type": "object",
  "required": ["gene_ids"],
  "additionalProperties": false,
  "properties": {
    "gene_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1},
      "description": "Identifiers in exact expression-column order."
    },
    "namespace": {"type": "string", "minLength": 1, "default": "unspecified"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
